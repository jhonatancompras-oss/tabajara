+/// Edit the active sheet's persisted settings; preview invalidates on its revision.
+fn print_settings(app: &mut SheetApp, ui: &mut Ui, bs: &mut Backstage) {
+    let lang = app.ui.language;
+    let Some(d) = app.session.active() else { return };
+    let Some(sh) = d.wb.active() else { return };
+    let uid = d.uid;
+    let saved_area = sh.print.print_area.map(|r| r.a1()).unwrap_or_default();
+    let selection = d.selection.current().a1();
+    let margins = sh.print.margins;
+    if bs.print_area_draft.as_ref().is_none_or(|(id, _)| *id != uid) {
+        bs.print_area_draft = Some((uid, if saved_area.is_empty() { selection } else { saved_area.clone() }));
+    }
+    ui.label(lang.tr("Print Area"));
+    let draft = &mut bs.print_area_draft.as_mut().unwrap().1;
+    ui.add(egui::TextEdit::singleline(draft).desired_width(230.0).hint_text("A1:F40"));
+    ui.horizontal_wrapped(|ui| {
+        if ui.button(lang.tr("Set Print Area")).clicked() {
+            if draft.trim().is_empty() {
+                app.alert(lang.tr("Enter a range such as A1:F40.").to_owned());
+            } else {
+                app.run_or_alert("pageLayout.pageSetup", json!({"printArea": draft.trim()}));
+                bs.preview_page = 0;
+            }
+        }
+        if ui.button(lang.tr("Clear Print Area")).clicked() {
+            app.run_or_alert("pageLayout.pageSetup", json!({"printArea": ""}));
+            bs.preview_page = 0;
+        }
+    });
+    ui.label(format!("{}: {}", lang.tr("Current print area"), if saved_area.is_empty() { lang.tr("Entire used range") } else { &saved_area }));
+    ui.add_space(8.0);
+    ui.label(lang.tr("Margins (cm)"));
+    egui::Grid::new("preview_margins").num_columns(2).show(ui, |ui| {
+        for (i, key, label) in [(0, "left", "Left"), (1, "right", "Right"), (2, "top", "Top"), (3, "bottom", "Bottom")] {
+            ui.label(lang.tr(label));
+            let mut cm = f64::from(margins[i]) * 2.54;
+            if ui.add(egui::DragValue::new(&mut cm).speed(0.05).range(0.0..=7.62).max_decimals(2).suffix(" cm")).changed() {
+                let mut params = json!({});
+                params[key] = json!(cm / 2.54);
+                app.run_or_alert("pageLayout.pageSetup", params);
+            }
+            ui.end_row();
+        }
+    });
+    ui.add_space(8.0);
 }
 
